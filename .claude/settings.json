{
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ty check *)",
      "Bash(npm list *)",
      "Bash(npm run test *)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "enabledPlugins": {
    "astral@astral-sh": true,
    "squid@iusztinpaul": true
  },
  "extraKnownMarketplaces": {
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "iusztinpaul": {
      "source": {
        "source": "github",
        "repo": "iusztinpaul/squid"
      }
    }
  }
}
